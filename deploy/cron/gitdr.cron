# /etc/cron.d/gitdr, daily immutable backup at 02:00. Runs the wrapper as root, which reads the
# secrets and then runs gitdr as the gitdr user (gitdr-backup.sh).
# cron mails stdout/stderr to MAILTO on failure (non-zero exit = failed backup).
MAILTO=root
0 2 * * *  root  /usr/local/bin/gitdr-backup.sh
